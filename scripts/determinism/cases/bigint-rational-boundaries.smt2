; Common denominators, large rational components, and signed rounding.
; API-only conversion and aliasing regressions run in test-z3 before this corpus.
(set-info :status unsat)
(define-fun a () Real (/ 1.0 4.0))
(define-fun b () Real (/ 1.0 6.0))
(define-fun near-one () Real (/ .0 .0))
(simplify (+ a b))
(simplify (- a b))
(simplify ((_ to_fp 11 53) RNE near-one))
(assert (or
  (distinct (+ a b) (/ 5.0 12.0))
  (distinct (- a b) (/ 1.0 12.0))
  (distinct (* (/ 4294967297.0 3.0) (/ 3.0 4294967297.0)) 1.0)
  (distinct (to_int (/ (- 2147483648.0) 3.0)) (- 715827883))
  (distinct (to_int (/ 2147483648.0 3.0)) 715827882)))
(check-sat)
